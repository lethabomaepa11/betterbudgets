# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
NEXT_PUBLIC_SERVER_URL=

# Public origin used in QR/share links. Set this to a deployed or LAN-reachable
# URL when transferring between devices; localhost is only reachable on this device.
# @public @required=false @type=url
NEXT_PUBLIC_APP_URL=

# Published mobile store URLs. Leave empty until the corresponding release is live.
# @public @required=false @type=url
NEXT_PUBLIC_IOS_APP_URL=

# @public @required=false @type=url
NEXT_PUBLIC_ANDROID_APP_URL=

# --- Server-only environment variables (for API routes) ---
# These are NOT exposed to the client bundle

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Groq is called only by the backend. Never expose this key to the web app.
# @dynamic @required=false @type=string(minLength=1)
GROQ_API_KEY=

# Optional Groq model override; the default is a current fast general model.
# @dynamic @required=false @type=string(minLength=1)
GROQ_MODEL=llama-3.3-70b-versatile
