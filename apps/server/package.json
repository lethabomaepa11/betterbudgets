{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "prebuild": "pnpm --filter @betterbudgets/db db:generate",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "start": "node dist/index.mjs",
    "dev:bare": "tsx watch src/index.ts",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes"
  },
  "dependencies": {
    "@betterbudgets/auth": "workspace:*",
    "@betterbudgets/db": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-auth": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@betterbudgets/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
