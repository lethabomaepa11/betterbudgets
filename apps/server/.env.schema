# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Groq is called only by the backend. Never expose this key to the web app.
# @dynamic @required=false @type=string(minLength=1)
GROQ_API_KEY=

# Optional Groq model override; the default is a current fast general model.
# @dynamic @required=false @type=string(minLength=1)
GROQ_MODEL=llama-3.3-70b-versatile
